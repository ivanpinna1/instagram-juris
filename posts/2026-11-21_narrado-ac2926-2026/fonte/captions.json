8.72}, {"w": "resumir:", "t": 69.0}]}, {"t0": 70.04, "t1": 71.1, "text": "recurso negado,", "words": [{"w": "recurso", "t": 70.04}, {"w": "negado,", "t": 70.5}]}, {"t0": 71.4, "t1": 74.02, "text": "mas a ilegalidade é clara?", "words": [{"w": "mas", "t": 71.4}, {"w": "a", "t": 71.82}, {"w": "ilegalidade", "t": 72.3}, {"w": "é", "t": 73.22}, {"w": "clara?", "t": 73.64}]}, {"t0": 74.48, "t1": 76.04, "text": "Leve o caso, por escrito,", "words": [{"w": "Leve", "t": 74.48}, {"w": "o", "t": 75.02}, {"w": "caso,", "t": 75.16}, {"w": "por", "t": 75.34}, {"w": "escrito,", "t": 75.58}]}, {"t0": 76.04, "t1": 77.88, "text": "à instância superior,", "words": [{"w": "à", "t": 76.04}, {"w": "instância", "t": 76.56}, {"w": "superior,", "t": 77.1}]}, {"t0": 78.46, "t1": 82.6, "text": "citando o Acórdão 2926 de 2026,", "words": [{"w": "citando", "t": 78.46}, {"w": "o", "t": 78.92}, {"w": "Acórdão", "t": 79.06}, {"w": "2926", "t": 79.48}, {"w": "de", "t": 81.12}, {"w": "2026,", "t": 81.68}]}, {"t0": 82.6, "t1": 85.16, "text": "do Plenário do Tribunal de Contas da União.", "words": [{"w": "do", "t": 82.6}, {"w": "Plenário", "t": 83.16}, {"w": "do", "t": 83.7}, {"w": "Tribunal", "t": 83.86}, {"w": "de", "t": 84.18}, {"w": "Contas", "t": 84.4}, {"w": "da", "t": 84.66}, {"w": "União.", "t": 84.84}]}, {"t0": 85.62, "t1": 88.24, "text": "E se quiserem rever uma decisão contra você", "words": [{"w": "E", "t": 85.62}, {"w": "se", "t": 86.18}, {"w": "quiserem", "t": 86.24}, {"w": "rever", "t": 86.6}, {"w": "uma", "t": 86.82}, {"w": "decisão", "t": 87.04}, {"w": "contra", "t": 87.56}, {"w": "você", "t": 87.84}]}, {"t0": 88.58, "t1": 89.4, "text": "sem te ouvir,", "words": [{"w": "sem", "t": 88.58}, {"w": "te", "t": 88.9}, {"w": "ouvir,", "t": 89.14}]}, {"t0": 89.96, "t1": 91.04, "text": "exija ser ouvido.", "words": [{"w": "exija", "t": 89.96}, {"w": "ser", "t": 90.38}, {"w": "ouvido.", "t": 90.6}]}, {"t0": 91.86, "t1": 94.16, "text": "Sua empresa já desistiu de uma licitação", "words": [{"w":