[{"t0": 1.52, "t1": 3.7, "text": "Perdeu o recurso na licitação", "words": [{"w": "Perdeu", "t": 1.52}, {"w": "o", "t": 2.22}, {"w": "recurso", "t": 2.32}, {"w": "na", "t": 2.78}, {"w": "licitação", "t": 2.92}]}, {"t0": 3.7, "t1": 5.0, "text": "e ouviu que acabou,", "words": [{"w": "e", "t": 3.7}, {"w": "ouviu", "t": 4.18}, {"w": "que", "t": 4.64}, {"w": "acabou,", "t": 4.64}]}, {"t0": 5.54, "t1": 6.64, "text": "que não cabe mais nada?", "words": [{"w": "que", "t": 5.54}, {"w": "não", "t": 5.6}, {"w": "cabe", "t": 5.74}, {"w": "mais", "t": 6.0}, {"w": "nada?", "t": 6.26}]}, {"t0": 7.34, "t1": 8.22, "text": "Não é bem assim.", "words": [{"w": "Não", "t": 7.34}, {"w": "é", "t": 7.66}, {"w": "bem", "t": 7.8}, {"w": "assim.", "t": 7.92}]}, {"t0": 8.86, "t1": 9.48, "text": "Imagina:", "words": [{"w": "Imagina:", "t": 8.86}]}, {"t0": 10.04, "t1": 11.46, "text": "sua empresa é desclassificada", "words": [{"w": "sua", "t": 10.04}, {"w": "empresa", "t": 10.16}, {"w": "é", "t": 10.38}, {"w": "desclassificada", "t": 10.58}]}, {"t0": 11.46, "t1": 13.1, "text": "por um erro da comissão.", "words": [{"w": "por", "t": 11.46}, {"w": "um", "t": 11.76}, {"w": "erro", "t": 11.92}, {"w": "da", "t": 12.26}, {"w": "comissão.", "t": 12.58}]}, {"t0": 13.68, "t1": 14.5, "text": "Você recorre.", "words": [{"w": "Você", "t": 13.68}, {"w": "recorre.", "t": 13.9}]}, {"t0": 15.24, "t1": 17.24, "text": "Dias depois, chega a resposta:", "words": [{"w": "Dias", "t": 15.24}, {"w": "depois,", "t": 15.48}, {"w": "chega", "t": 16.36}, {"w": "a", "t": 16.72}, {"w": "resposta:", "t": 16.82}]}, {"t0": 18.06, "t1": 19.2, "text": "recurso negado.", "words": [{"w": "recurso", "t": 18.06}, {"w": "negado.", "t": 18.6}]}, {"t0": 20.1, "t1": 21.14, "text": "E junto vem a frase:", "words": [{"w": "E", "t": 20.1}, {"w": "junto", "t": 20.32}, {"w": "vem", "t": 20.52}, {"w": "a", "t": 20.72}, {"w": "frase:", "t": 20.86}]}, {"t0": 21.7, "t1": 24.32, "text": "a via administrativa está encerrada.", "words": [{"w": "a",